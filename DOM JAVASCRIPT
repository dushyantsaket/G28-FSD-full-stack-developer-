let cardcontainer = document.getElementById("card-container");

// function to create card (reuse logic)
function createCard() {
  let div = document.createElement("div");
  div.style.border = "3px solid black";
  div.style.width = "250px";
  div.style.padding = "10px";
  div.style.display = "flex";
  div.style.flexDirection = "column";

  let image = document.createElement("img");
  image.src = "https://imgd.aeplcdn.com/664x374/n/cw/ec/191853/mercedes-benz-amg-g-class-right-front-three-quarter7.jpeg?isig=0&wm=1&q=80";
  image.style.width = "100%";
  image.style.padding = "10px";

  let title = document.createElement("h2");
  title.innerText = "Mercedes-Benz AMG G-Class G 63";

  let description = document.createElement("p");
  description.innerText =
    "Power, heritage, and unparalleled performance. The all-new Mercedes-AMG G 63 combines thrilling performance with exquisite design.";

  let price = document.createElement("h6");
  price.innerText = "Price: $3,400,000";

  let button = document.createElement("button");
  button.innerText = "BUY";
  button.style.padding = "10px 20px";
  button.style.background = "blue";
  button.style.color = "pink";

  div.append(image, title, description, price, button);

  return div;
}

// add multiple cards
for (let i = 0; i < 3; i++) {
  cardcontainer.appendChild(createCard());
}

// fix gap
cardcontainer.style.display = "flex";
cardcontainer.style.gap = "20px";
